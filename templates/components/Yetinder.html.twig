<article {{ attributes.defaults({class: 'overflow-hidden rounded-3xl border border-white/10 bg-white/[0.04] shadow-2xl shadow-black/20'}) }}>
    
    {% if yeti %}

        <div class="grid gap-0 md:grid-cols-[0.8fr_1.2fr]">
            
            <div class="flex min-h-64 items-center justify-center bg-gradient-to-br from-cyan-300/20 via-sky-400/10 to-indigo-400/20 p-10">
                <div class="flex h-40 w-40 items-center justify-center rounded-full border border-white/20 bg-slate-950/30 text-7xl shadow-inner" aria-hidden="true">❄️</div>
            </div>
            
            <div class="p-7 sm:p-10">
                <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-300">Váš dnešní objev</p>
                <h2 class="mt-3 text-3xl font-bold text-white">{{ yeti.jmeno }}</h2>
                <p class="mt-3 leading-7 text-slate-400">{{ yeti.popis ?: 'Zatím o sobě neprozradil žádné podrobnosti. Možná je na čase se seznámit!' }}</p>
                <dl class="mt-7 grid grid-cols-2 gap-4">
                    <div class="rounded-2xl bg-slate-950/50 p-4">
                        <dt class="text-xs uppercase tracking-wider text-slate-500">Pohlaví</dt>
                        <dd class="mt-1 font-medium text-slate-100">{{ yeti.pohlavi ? yeti.pohlavi.label : 'Neuvedeno' }}</dd>
                    </div>
                    <div class="rounded-2xl bg-slate-950/50 p-4">
                        <dt class="text-xs uppercase tracking-wider text-slate-500">Bydliště</dt>
                        <dd class="mt-1 font-medium text-slate-100">{{ yeti.bydliste }}</dd>
                    </div>
                    <div class="rounded-2xl bg-slate-950/50 p-4">
                        <dt class="text-xs uppercase tracking-wider text-slate-500">Výška</dt>
                        <dd class="mt-1 font-medium text-slate-100">{{ yeti.vyska }} cm</dd>
                    </div>
                    <div class="rounded-2xl bg-slate-950/50 p-4">
                        <dt class="text-xs uppercase tracking-wider text-slate-500">Váha</dt>
                        <dd class="mt-1 font-medium text-slate-100">{{ yeti.vaha }} kg</dd>
                    </div>
                </dl>
                <div class="mt-8 flex flex-wrap gap-3">
                    <button type="button" {{ live_action('ohodnot', {'hodnota': -1}) }} class="rounded-full border border-rose-300/30 bg-rose-300/10 px-6 py-3 font-semibold text-rose-200 transition hover:bg-rose-300/20">👎 Nesedíme si</button>
                    <button type="button" {{ live_action('ohodnot', {'hodnota': 1}) }} class="rounded-full bg-cyan-300 px-6 py-3 font-semibold text-slate-950 transition hover:bg-cyan-200">👍 To je sympaťák</button>
                </div>
            </div>

        </div>
    
    {% else %}

        <div class="px-6 py-16 text-center">
            <span class="text-5xl" aria-hidden="true">🏔️</span>
            <h2 class="mt-5 text-2xl font-bold text-white">Zatím tu není žádný další Yeti</h2>
            <p class="mx-auto mt-3 max-w-md text-slate-400">Přidejte prvního nebo dalšího Yetiho a vraťte se, až bude koho hodnotit.</p>
            <a href="{{ path('pridani_yetiho') }}" class="mt-6 inline-flex rounded-full bg-cyan-300 px-5 py-3 font-semibold text-slate-950 transition hover:bg-cyan-200">Přidat Yetiho</a>
        </div>

    {% endif %}

</article>
