{% extends 'base.html.twig' %}

{% block title %}Přidat Yetiho | Best of Yeti{% endblock %}

{% block main %}
    <section class="mx-auto max-w-3xl px-5 py-12 sm:px-8">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.22em] text-cyan-300">Rozšiřte naši komunitu</p>
        <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">Přidat nového Yetiho</h1>
        <p class="mt-4 max-w-2xl leading-7 text-slate-400">Znáte dalšího skvělého obyvatele hor? Přidejte jeho profil a nechte ostatní, ať ho poznají.</p>
        <div class="mt-8 rounded-3xl border border-white/10 bg-white/[0.04] p-6 shadow-2xl shadow-black/20 sm:p-8">
            {{ component('pridani_yetiho') }}
        </div>
    </section>
{% endblock %}
