{% extends 'base.html.twig' %}
{% import 'macros/hodnoceni.html.twig' as hodnoceni %}

{% block title %}Statistika hodnocení | Best of Yeti{% endblock %}

{% block main %}

    <section class="mx-auto max-w-5xl px-5 py-12 sm:px-8">

        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.22em] text-cyan-300">Čísla z našich hor</p>
        <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">Statistika hodnocení</h1>
        <p class="mt-4 max-w-2xl leading-7 text-slate-400">Přehled měsíční aktivity a hlasů, kterými návštěvníci hodnotí naše Yetie.</p>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
            <article class="rounded-3xl border border-white/10 bg-white/[0.04] p-6">
                <p class="text-sm text-slate-400">Yetiů v katalogu</p>
                <p class="mt-2 text-4xl font-bold text-white">{{ pocetYeti }}</p>
            </article>
            <article class="rounded-3xl border border-white/10 bg-white/[0.04] p-6">
                <p class="text-sm text-slate-400">Rozdaných hodnocení</p>
                <p class="mt-2 text-4xl font-bold text-white">{{ hodnoceniPocet }}</p>
            </article>
        </div>

        <div class="mt-8 overflow-hidden rounded-3xl border border-white/10 bg-white/[0.04]">
            <div class="border-b border-white/10 px-6 py-5">
                <h2 class="text-lg font-semibold text-white">Hodnocení po měsících</h2>
                <p class="mt-1 text-sm text-slate-400">Počet hlasů a jejich průměrná hodnota v posledních 12 aktivních měsících.</p>
            </div>

            {% if mesicniPrehled is not empty %}

                <div class="overflow-x-auto">
                    <table class="w-full min-w-[34rem] text-left text-sm">
                        <thead class="bg-slate-950/40 text-xs uppercase tracking-wider text-slate-500">
                            <tr>
                                <th scope="col" class="px-6 py-4 font-medium">Měsíc</th>
                                <th scope="col" class="px-6 py-4 font-medium">Počet hodnocení</th>
                                <th scope="col" class="px-6 py-4 font-medium">Průměr</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5 text-slate-300">
                            
                            {% for mp in mesicniPrehled %}
                                <tr>
                                    <th scope="row" class="px-6 py-4 font-medium text-white">{{ mp.mesic }}</th>
                                    <td class="px-6 py-4">{{ mp.hodnoceniPocet }}</td>
                                    <td class="px-6 py-4">{{ hodnoceni.procenta(mp.hodnoceniProcenta) }}</td>
                                </tr>
                            {% endfor %}

                        </tbody>
                    </table>
                </div>

            {% else %}

                <p class="px-6 py-10 text-center text-slate-400">Statistika se zobrazí, jakmile někdo ohodnotí prvního Yetiho.</p>
                
            {% endif %}

        </div>

    </section>

{% endblock %}
