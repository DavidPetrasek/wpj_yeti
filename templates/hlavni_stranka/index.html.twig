{% extends 'base.html.twig' %}

{% block title %}Best of Yeti{% endblock %}

{% block main %}

    <section class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
        <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
            <div>
                <p class="mb-3 text-sm font-semibold uppercase tracking-[0.22em] text-cyan-300">Žebříček horských legend</p>
                <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">Best of Yeti</h1>
                <p class="mt-4 max-w-2xl leading-7 text-slate-400">Deset nejlépe hodnocených Yetiů z naší komunity. Každý hlas pomáhá určit, kdo kraluje horám.</p>
            </div>
            <a href="{{ path('pridani_yetiho') }}" class="inline-flex shrink-0 items-center justify-center rounded-full bg-cyan-300 px-5 py-3 font-semibold text-slate-950 transition hover:bg-cyan-200">+ Přidat Yetiho</a>
        </div>

        <div class="mt-9 overflow-hidden rounded-3xl border border-white/10 bg-white/[0.04] shadow-2xl shadow-black/20">
            
            {% if nejlepsiYeti is not empty %}
            
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[42rem] text-left text-sm">
                        <thead class="bg-slate-950/40 text-xs uppercase tracking-wider text-slate-500">
                            <tr>
                                <th scope="col" class="px-6 py-4 font-medium">Pořadí / Yeti</th>
                                <th scope="col" class="px-6 py-4 font-medium">Výška</th>
                                <th scope="col" class="px-6 py-4 font-medium">Váha</th>
                                <th scope="col" class="px-6 py-4 font-medium">Bydliště</th>
                                <th scope="col" class="px-6 py-4 font-medium">Hodnocení</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5 text-slate-300">
                            {% for prehled in nejlepsiYeti %}
                                <tr class="transition hover:bg-white/[0.03]">
                                    <th scope="row" class="px-6 py-4 font-medium text-white">
                                        <span class="mr-3 inline-flex h-8 w-8 items-center justify-center rounded-full bg-cyan-300/10 text-xs text-cyan-200">{{ loop.index }}</span>
                                        {{ prehled.yeti.jmeno }}
                                    </th>
                                    <td class="px-6 py-4">{{ prehled.yeti.vyska }} cm</td>
                                    <td class="px-6 py-4">{{ prehled.yeti.vaha }} kg</td>
                                    <td class="px-6 py-4">{{ prehled.yeti.bydliste }}</td>
                                    <td class="px-6 py-4">
                                        <span class="font-semibold text-amber-200">★ {{ prehled.hodnoceniPrumer|number_format(2, ',', ' ') }}</span>
                                        <span class="ml-1 text-xs text-slate-500">({{ prehled.hodnoceniPocet }})</span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

            {% else %}

                <div class="px-6 py-16 text-center">
                    <span class="text-5xl" aria-hidden="true">❄️</span>
                    <h2 class="mt-5 text-2xl font-bold text-white">Žebříček zatím čeká na prvního Yetiho</h2>
                    <p class="mx-auto mt-3 max-w-md text-slate-400">Přidejte prvního obyvatele hor a odstartujte soutěž o nejlepšího Yetiho.</p>
                    <a href="{{ path('pridani_yetiho') }}" class="mt-6 inline-flex rounded-full border border-white/15 px-5 py-2.5 font-medium text-white transition hover:bg-white/10">Přidat prvního Yetiho</a>
                </div>

            {% endif %}

        </div>
    </section>

{% endblock %}